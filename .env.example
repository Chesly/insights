# Copy this file to .env.local for local development.
# In production, set these in your hosting platform's environment variables
# dashboard (e.g. Vercel → Project → Settings → Environment Variables).
# Vars are grouped below by whether the site actually breaks without them.

# --- REQUIRED — core site data (Supabase) ---------------------------------
# Project Settings > API. The URL + anon key are safe to expose to the
# browser; every page read (posts, downloads, categories) goes through them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role key. SECRET — never expose to the
# browser. Bypasses Row Level Security; required for every action that
# writes as the site itself rather than as a logged-in admin: issuing/
# redeeming digital-download tokens (/api/downloads/claim, /api/download/
# [token]), creating orders (/api/checkout), and validating coupons
# (/api/coupons/validate). Missing or wrong here throws inside
# createServiceClient() and every one of those routes returns a bare 500.
SUPABASE_SERVICE_ROLE_KEY=

# --- REQUIRED — checkout (Paystack) ----------------------------------------
# Paystack Dashboard > Settings > API Keys & Webhooks. Secret key, not the
# public one. Without it /api/checkout refuses to start a transaction.
PAYSTACK_SECRET_KEY=

# --- REQUIRED — admin media/file uploads (ImageKit) ------------------------
# ImageKit Dashboard > Developer options > Private Key. Without it, the
# admin upload endpoint (/api/media/upload) — images, digital product
# files — fails.
IMAGEKIT_PRIVATE_KEY=

# --- Optional — contact form email notifications (Resend) ------------------
# resend.com > API Keys. Without it, contact form submissions still save
# to the admin inbox (/admin/messages) fine — this just also emails a
# copy to Settings > Contact Details > Contact Email. Verify your own
# sending domain in the Resend dashboard for production use; the "from"
# address falls back to onboarding@resend.dev (Resend's shared sandbox
# domain) until you do.
RESEND_API_KEY=

# --- Optional — public site chrome -----------------------------------------
# Used to build absolute URLs in a couple of API responses (public posts
# feed, newsletter subscribe confirmation). Falls back to siteConfig.url
# behavior when unset — check src/lib/siteConfig.ts if omitting this.
INSIGHTS_SITE_URL=

# Shared secret the scheduled publish cron must send to /api/cron/publish.
CRON_SECRET=

# Google Analytics 4 — Admin > Data Streams > your stream > Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Tag Manager — container ID, format GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID=

# Microsoft Clarity — Settings > Setup > Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google Search Console — HTML tag verification method, the "content" value only
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools — HTML tag verification method, the "content" value only
NEXT_PUBLIC_BING_SITE_VERIFICATION=
